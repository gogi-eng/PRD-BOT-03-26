# AGENT-WORLD: Telethon-каналы + очередь RSS (agent_world) в одном процессе.
# Отдельная Telethon-сессия (session_name в config) — НЕ файл прода.
# Bot API polling панели — у trading_bot_agent_world (другой TELEGRAM_TOKEN).
[Unit]
Description=PRD AGENT-WORLD Telegram channels + RSS (world_events → inbox)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=@REPO_DIR@
Environment=PRD_LOG_STDERR=1
ExecStart=@PYTHON@ @REPO_DIR@/scripts/telegram_signal_agent.py --repo-dir @REPO_DIR@
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
