# Unified PRD agent (торговля + кнопки Telegram).
# Установка:
#   sudo cp deploy/trading_bot.service /etc/systemd/system/trading_bot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now trading_bot
[Unit]
Description=PRD Unified Trading Bot (Bybit + Telegram buttons)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/PRD-BOT-ALL
Environment=PRD_UNIFIED_POLLING=1
Environment=PRD_LOG_STDERR=1
# Только venv — не .venv (дубликаты вызывают Conflict getUpdates)
ExecStart=/root/PRD-BOT-ALL/venv/bin/python3 /root/PRD-BOT-ALL/run_unified.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
