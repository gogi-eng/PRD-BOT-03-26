# Песочница на субаккаунте (/root/AGENT-WORLD). Свой TELEGRAM_TOKEN — кнопки через control_polling_enabled: true.
#
#   sudo cp deploy/trading_bot_agent_world.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now trading_bot_agent_world
[Unit]
Description=PRD AGENT-WORLD sandbox (ALGO branch, sub-account)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=@REPO_DIR@
Environment=PRD_LOG_STDERR=1
Environment=PRD_AGENT_WORLD=1
Environment=HTTPX_LOG_LEVEL=warning
ExecStart=@PYTHON@ @REPO_DIR@/run_unified.py
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
