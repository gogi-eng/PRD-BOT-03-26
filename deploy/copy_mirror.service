# Зеркало Copy Trading — отдельная папка /root/BOT-Mirror (не PRD-BOT-ALL!)
#   sudo cp deploy/copy_mirror.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now copy_mirror

[Unit]
Description=PRD Copy Mirror / BOT-Mirror (Classic copy → subaccount)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/BOT-Mirror
EnvironmentFile=-/root/BOT-Mirror/.env
ExecStart=/root/BOT-Mirror/venv/bin/python3 /root/BOT-Mirror/run_copy_mirror.py
Restart=always
RestartSec=20

[Install]
WantedBy=multi-user.target
