# Пример переменных окружения для PRD-BOT / AGENT-WORLD.
# Скопируйте на сервер в /root/AGENT-WORLD/.env (или /root/PRD-BOT-ALL/.env)
# и заполните вручную. НЕ коммитьте реальный .env и НЕ присылайте ключи в чат.

# Bybit / Telegram — уже используются ботом
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# OpenRouter (ai.provider: openrouter)
OPENROUTER_API_KEY=

# DeepSeek напрямую (ai.provider: deepseek)
DEEPSEEK_API_KEY=

# AIAI.BY — OpenAI-compatible API из Беларуси (ai.provider: aiai)
# Документация: https://aiai.by/docs  base_url=https://api.aiai.by/v1
AIAI_API_KEY=
# Альтернативное имя (тоже читается шлюзом):
# AIAI_BY_API_KEY=
